{
  "name": "motion-tracker-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "frontend": "node scripts/serve-frontend.js",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "validate": "prisma validate",
    "test": "node --env-file-if-exists=.env --test test/*.test.js",
    "test:database": "node --env-file-if-exists=.env --test test/database.test.js",
    "check": "node scripts/check.js",
    "setup:database": "node scripts/setup-database.js",
    "migrate:all": "node scripts/migrate-databases.js",
    "smoke:live": "node scripts/smoke-live.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "prisma": "^7.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
